# ========================================================
# KIHO CAMERA - ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase Configuration
# Lấy từ Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-backend-only

# Server-only key used to encrypt integration secrets.
# Generate one with: openssl rand -base64 32
# Never prefix this variable with NEXT_PUBLIC_.
INTEGRATION_ENCRYPTION_KEY=

# Public Website Base URL (dùng cho Canonical SEO, OpenGraph và Sitemap)
NEXT_PUBLIC_SITE_URL=https://kihocamera.com

# Facebook & Contact Defaults (Nếu chưa lưu trong Database site_settings)
NEXT_PUBLIC_DEFAULT_MESSENGER_URL=https://m.me/kihocameradonghoi
NEXT_PUBLIC_DEFAULT_FACEBOOK_URL=https://facebook.com/kihocameradonghoi
NEXT_PUBLIC_DEFAULT_PHONE=0387274669

# Development-only fallbacks. Keep both false in production.
ALLOW_LOCAL_DATA_FALLBACK=false
ALLOW_INSECURE_DEV_ENCRYPTION_FALLBACK=false

# Google Sheets settings and webhook secret are managed from the authenticated
# Admin page. See docs/GOOGLE_SHEETS_SETUP.md.
